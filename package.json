{
  "name": "aureva",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:rules": "firebase emulators:exec --only firestore --project aureva-rules-test \"node tests/firestore.rules.test.mjs\"",
    "test:imports": "firebase emulators:exec --only firestore --project aureva-import-check \"node tests/import.check.mjs\"",
    "test:ui": "tsx tests/variants.test.tsx",
    "test:dupes": "tsx tests/duplicates.test.tsx",
    "test:stats": "tsx tests/inventory.stats.test.tsx",
    "test:upi": "tsx tests/upi.test.tsx",
    "test": "npm run test:rules && npm run test:imports && npm run test:ui && npm run test:dupes && npm run test:stats && npm run test:upi && npm run test:inline && npm run test:gst && npm run test:build",
    "test:build": "node scripts/check-build.mjs",
    "test:gst": "tsx tests/business.test.tsx",
    "test:inline": "tsx tests/inline-edit.test.tsx"
  },
  "dependencies": {
